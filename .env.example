# Copy this file to .env and fill in the values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use (free-tier "flash" model)
LLM_MODEL=gemini-3.6-flash

# Used automatically if the main model is overloaded or rate limited
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Max agent runs per visitor IP per day on the public demo
RUNS_PER_IP_PER_DAY=10
